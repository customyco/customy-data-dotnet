<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>Customy.Data</PackageId>
    <Version>0.1.1</Version>
    <Authors>Customy</Authors>
    <Description>Governed customer data collection SDK for .NET.</Description>
    <PackageProjectUrl>https://customy.ai</PackageProjectUrl>
    <RepositoryUrl>https://github.com/customyco/customy-data-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
